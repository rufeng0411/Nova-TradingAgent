# =============================================================================
# Quick start (required) — copy this file to `.env` and keep these set.
# Password: letters + digits, at least 8 characters. Change before any network deploy.
# =============================================================================
TA_ADMIN_EMAIL=admin@localhost
TA_ADMIN_USERNAME=admin
TA_ADMIN_PASSWORD=ChangeMe_Admin1!
TA_APP_SECRET_KEY=please-change-this-to-a-32byte-or-longer-secret
DATABASE_URL=sqlite:///./data/tradingagents.db
TA_ALLOW_REGISTRATION=0

# Optional for running an analysis (the UI still loads without them):
# TA_API_KEY=
# TUSHARE_TOKEN=

# Level-2 order queue is opt-in. Needs a Tushare L2 entitlement.
# Missing permission returns empty data; analysis continues.
TA_TUSHARE_L2_ENABLED=0

# --- Everything below is optional / advanced ---

# --- 核心模型接入 (Core LLM) ---
# 建议统一使用 TA_ 前缀，同时也兼容 OPENAI_API_KEY / OPENAI_BASE_URL
TA_API_KEY=
TA_BASE_URL=https://api.openai.com/v1
TA_LLM_PROVIDER=openai

# 模型名配置 (默认已提供常用值)
TA_LLM_QUICK=gpt-4o-mini
TA_LLM_DEEP=gpt-4o

# --- 安全密钥 (Security) ---
# 用于加密用户 API Key 和签发 JWT，生产环境必须设置！
# 长度要求：≥ 32 字节（HMAC-SHA256 推荐），否则 PyJWT 每次解 token 都会刷
# `InsecureKeyLengthWarning: The HMAC key is N bytes long...` 警告。
# 生成方式（任选其一）：
#   openssl rand -hex 32                    # 64 字符 hex（32 字节）
#   openssl rand -base64 32                 # base64 编码（约 44 字符）
#   python -c "import secrets;print(secrets.token_hex(32))"
# 首次设置时，系统会自动将已有数据从默认密钥迁移到新密钥；变更后所有现有 JWT 会失效，
# 客户端需要重新登录一次。
# TA_APP_SECRET_KEY=

# --- 进阶可选配置 (Advanced Optional) ---
# 提示词语言 (auto / zh / en)，默认 zh
# TA_LANGUAGE=zh

# 运行日志追踪 (1 开启 / 0 关闭)，默认 1
# TA_TRACE=1

# 辩论与风险讨论轮数 (1-5)，默认 1
# TA_MAX_DEBATE=1
# TA_MAX_RISK=1

# --- VLM 截图识别 (Vision Language Model) ---
# 用于持仓截图识别，默认使用智谱 glm-4.6v-flash（免费）
# TA_VLM_API_KEY=你的智谱API Key
# TA_VLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# TA_VLM_MODEL=glm-4.6v-flash

# --- SaaS 认证 / 计费 / 管理（用户名+密码 + JWT）---
# 首次启动会根据以下变量创建/提升管理员（生产请务必修改密码）
# 默认管理员邮箱统一为 admin@localhost（与代码内 DEFAULT_ADMIN_EMAIL 一致）；生产请改成你的域名邮箱
# TA_ADMIN_EMAIL=admin@localhost
# TA_ADMIN_USERNAME=admin
# TA_ADMIN_PASSWORD=请使用强密码
# 开放注册（黄金路径已在文件顶部设为 0，只留默认管理员）
# TA_ALLOW_REGISTRATION=0
# 新用户赠送点数
# TA_REGISTRATION_DEFAULT_CREDITS=50
# 单次智能分析消耗点数（402 余额不足）
# TA_COST_ANALYSIS=10
# 快速分析单次扣点（2 分钟短线决策辅助）
# TA_FAST_ANALYSIS_ENABLED=0
# TA_FAST_LLM_MODEL=deepseek-chat
# TA_FAST_BUDGET_SEC=120
# TA_FAST_COST_POINTS=2
# TA_FAST_SSE_ENABLED=1
#
# --- Analysis job durability / LangGraph checkpoints ---
# TA_JOBSTORE_CLEAR_ON_START=1   # Dev only: wipe Redis/in-memory job store on API boot (default off)
# TA_INSTANCE_ID=worker-a        # Optional stable id for lease ownership logging
# TA_ANALYSIS_LEASE_RUNNING_SEC=900
# TA_ANALYSIS_RECLAIM_GRACE_SEC=120
# 聊天面板新提交链路（V2）：1 开启（默认），0 关闭后前端会回退旧 chat completions 提交路径
# TA_CHAT_TASK_SUBMIT_V2_ENABLED=1
# 用户任务中心队列总开关（默认开启）
# TA_USER_TASK_QUEUE_ENABLED=1
# LANGGRAPH_CHECKPOINTER=sqlite   # sqlite | memory | postgres
# LANGGRAPH_CHECKPOINT_SQLITE=sqlite:///./custom_langgraph.sqlite
# LANGGRAPH_POSTGRES_URI=postgresql+psycopg://user:pass@127.0.0.1:5433/langgraph_checkpoint
# [Windows developer optional — not required for the SQLite golden path]
# Electron launcher / local Postgres / Redis. Ignore this block unless you already run that stack.
# TA_POSTGRES_HOME=
# TA_PGCTL_PATH=
# TA_POSTGRES_DATA=
# TA_PSQL_PATH=
# TA_REDIS_HOME=D:\pgsql\redis
# TA_REDIS_CONF=D:\pgsql\redis\redis.windows.conf
# TA_REDIS_SERVER_PATH=   # 可选：直接指向 redis-server.exe
# REDIS_URL=redis://127.0.0.1:6379/0
#
# --- Marketdata warehouse (recommended PostgreSQL, optional split-engine) ---
# MARKETDATA_DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/tradingagents_marketdata
#
# 单次智能分析外层墙钟（秒）：多分析师+辩论+风控链路较慢，默认 3600。
# 设为 0 / none / unlimited 表示不在 API 层截断（仍可能受反向代理限制）。
# TA_JOB_TIMEOUT=3600
# 长任务心跳 SSE 间隔（秒），默认 120
# TA_JOB_HEARTBEAT_SEC=120

# 历史报告「兑现度」T+N 统计（默认开启；设为 0/false/off 可关闭以降低 Tushare 调用）
# TA_REPORT_OUTCOME_ENABLED=0
# 命中率阈值缩放（默认 1.0）；可用 scripts/sweep_outcome_threshold.py 扫描 0.8/1.0/1.2 后择优
# TA_REPORT_OUTCOME_THRESHOLD_FACTOR=1.0
# 本轮命中率优化版本标记（用于 report_outcomes.release_version 分组对比）
# TA_RELEASE_VERSION=translator-2026-06   # was hitrate-2026-05
# 后台巡检间隔（秒），默认 1200
# TA_REPORT_OUTCOME_EVAL_SEC=1200
#
# 图形验证码：默认关闭（0）。登录/注册/找回密码不校验图形验证码。仅当 TA_CAPTCHA_ENABLED=1 时 GET /v1/auth/captcha 会发图（可选场景）。
# TA_CAPTCHA_ENABLED=0
# TA_CAPTCHA_TTL_SECONDS=300
# 验证码 GET 限流（同 client IP）：窗口内最大次数，防刷；开发机多刷新易 429 可临时关闭或调大
# TA_CAPTCHA_RL_WINDOW_SECONDS=30
# TA_CAPTCHA_RL_MAX=60
# TA_CAPTCHA_RL_DISABLED=0
# 访问日志异步入库（0 关闭）；保留天数
# TA_ACCESS_LOG_ENABLED=1
# TA_ACCESS_LOG_RETENTION_DAYS=30
# 找回密码邮件中的前端链接（生产必填）
# TA_FRONTEND_URL=https://你的前端域名

# --- 邮件服务 (Email/SMTP) ---
# 用于找回密码、报告邮件等
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USER=你的邮箱
# MAIL_PASS=你的授权码
# MAIL_FROM=发件人名称
# MAIL_SSL=1

# 兼容说明: 系统自动识别 TA_ 前缀变量。
# 若需修改默认行为，取消上述注释并填值即可。

# --- 数据源 Tier 3 升级（默认关闭；按 Sprint 逐步开启）---
# 总开关：Sprint 1+ 全部新能力都受此控制；先保持 0，Provider 与表先就位再开
# TA_DATASOURCE_TIER3_ENABLED=0
#
# Tushare Pro：捐赠 5000 积分起可覆盖日 K / 北向资金 / 复权因子 / 财务三表
# 注册：https://tushare.pro/register  个人中心 → 接口 TOKEN
# TUSHARE_TOKEN=
# TA_TUSHARE_REGISTER=0           # =1 时 Provider Registry 才会注册 cn_tushare
# TUSHARE_RT_TOKEN=               # 可选：A股日线RT独立 token（未填则回退 TUSHARE_TOKEN）
# TA_TUSHARE_RT_ENABLED=1         # rt_k 总开关（前后端均参考）
# TA_TUSHARE_RT_RPS=200           # rt_k 每分钟调用上限（独立于 TUSHARE_RPS）
# TA_RT_K_TTL=8                   # rt_k 后端缓存秒数（建议 5~15）
# TA_RT_K_MAX_BATCH=200           # rt_k 单次最多拉取标的数量（逗号分隔 symbols）
# TA_TUSHARE_RT_DAILY_ENABLED=1   # stock_data 中优先使用 rt_daily（当日盘中/收盘后）
# TA_INTRADAY_RT_POLL_SEC=20      # 前端/调用方可参考的盘中轮询建议秒数（5~300）
# Tushare Pro is optional. L2 is opt-in (see Quick start). Missing L2 permission returns empty data; analysis continues.
# TA_TUSHARE_L2_ENABLED=0
# TA_TUSHARE_L2_API=stk_orderqueue
# TA_TUSHARE_FACTOR_ENABLED=1     # 因子相关接口（stk_factor_pro / cyq_*）
# TA_TUSHARE_PRO_ENABLED=1        # entitlement 中是否开放 tushare_pro
#
# K 线增强 feature flag（默认关闭，逐项灰度）
# TA_TS_AUCTION_ENABLED=0         # 集合竞价（stk_auction）
# TA_TUSHARE_AUCTION_OC_ENABLED=0 # 竞价 o/c（stk_auction_o / stk_auction_c）
# TA_TS_CYQ_ENABLED=0             # 筹码分布（cyq_perf / cyq_chips）
# TA_TS_MONEYFLOW_ENABLED=0       # 个股资金流（individual_moneyflow）
# TA_TS_FACTOR_PRO_ENABLED=0      # Pro 因子（stk_factor_pro）
# TA_TS_LIMIT_ENABLED=0           # 涨跌停事件（limit_list_d）
# TA_TS_TOPLIST_ENABLED=0         # 龙虎榜/大宗事件（top_list / block_trade）
# TA_TS_HSGT_ENABLED=0            # 北向资金（north_money / hsgt_top10）
# TA_TS_FIN_EVENT_ENABLED=0       # 财报事件（forecast / express / dividend / stk_holdertrade）
#
# 翻译官中间层（A/B 总开关 + 子开关）
# TA_TRANSLATOR_ENABLED=0
# TA_TRANSLATOR_ORDERBOOK_ENABLED=1
# TA_TRANSLATOR_ACTIVE_BUY_ENABLED=1
# TA_TRANSLATOR_MONEYFLOW_ENABLED=1
# TA_TRANSLATOR_FINANCIAL_ENABLED=1
#
# FRED（美联储经济数据，免费 API key；Sprint 4 美国宏观需要）
# 注册：https://fredaccount.stlouisfed.org/apikey
# FRED_API_KEY=
#
# 数据落库与对账（Sprint 2 启用）
# TA_MARKETDATA_SYNC_ENABLED=0
# TA_MARKETDATA_RECON_ENABLED=0
# TA_MARKETDATA_RECON_THRESHOLD=0.005   # 收盘价差阈值（0.5%）
#
# 本地优先路由（Sprint 3 启用；命中 marketdata_* 表时分析师直接读库副本）
# TA_DATASOURCE_LOCAL_FIRST=0
#
# 中国宏观与披露同步（Sprint 4 启用）
# TA_MACRO_SYNC_ENABLED=0
# JUCHAO_BASE_URL=https://www.cninfo.com.cn

# --- 前端 Vite 构建（可选）---
# 生产/静态部署时，若页面与 API 不同源，或静态服务器未将 /v1 反代到 FastAPI，请设置（否则 POST /v1 可能得到 405 Method Not Allowed）:
# VITE_API_URL=https://你的后端域名
# 开发时默认走 Vite 同源代理；若设 VITE_DEV_API_DIRECT=1 直连后端，局域网 IP 打开页面时勿将 VITE_API_URL 固定为 localhost（将误连到手机本机）。
# 根目录 `npm run dev` 已使用 uvicorn --host 0.0.0.0，便于局域网访问 :8000。

# --- 数据库 (Database) ---
# 默认 SQLite: sqlite:///./tradingagents.db（与 api/database.py 一致）
# 本地 MySQL：配置 TA_MYSQL_* 后执行 `uv run python scripts/create_mysql_database.py` 建库；再设 DATABASE_URL 并可选执行 migrate_sqlite_to_mysql.py
# TA_MYSQL_HOST=127.0.0.1
# TA_MYSQL_PORT=3306
# TA_MYSQL_USER=root
# TA_MYSQL_PASSWORD=
# TA_MYSQL_DATABASE=tradingagents
# DATABASE_URL=mysql+pymysql://USER:PASS@127.0.0.1:3306/tradingagents?charset=utf8mb4
# MySQL/Postgres 连接池（非 SQLite）：默认可并发约 70 条连接（pool 40 + overflow 30）；总连接数勿超过服务端 max_connections
# TA_DB_POOL_SIZE=40
# TA_DB_MAX_OVERFLOW=30
# TA_DB_POOL_TIMEOUT=60
# 若 MARKETDATA_DATABASE_URL 独立指向另一库，可单独调大行情库池（未设置则沿用 TA_DB_*）
# TA_MARKETDATA_DB_POOL_SIZE=40
# TA_MARKETDATA_DB_MAX_OVERFLOW=30
# TA_MARKETDATA_DB_POOL_TIMEOUT=60

# --- 0.2.5 升级 gate（默认全部关闭；本地验收可全开）---
# TA_UPGRADE_LLM_CATALOG=1
# TA_UPGRADE_STRUCTURED_OUTPUT=1
# TA_UPGRADE_PERSISTENT_MEMORY=1
# TA_UPGRADE_CHECKPOINT_UI=1

# --- 国产 / 多区 LLM（Sprint 1，与 TA_* 桥接共存）---
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# DASHSCOPE_CN_API_KEY=
# ZHIPU_API_KEY=
# ZHIPU_CN_API_KEY=
# MINIMAX_API_KEY=
# MINIMAX_CN_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# TRADINGAGENTS_LLM_PROVIDER=openai
# TRADINGAGENTS_DEEP_THINK_LLM=gpt-4o
# TRADINGAGENTS_QUICK_THINK_LLM=gpt-4o-mini
# TA_LLM_REGION=cn

# --- Qlib 量化评估沙盒（默认关闭，不接默认分析链）---
# TA_QLIB_EVAL_ENABLED=0
# TA_QLIB_SANDBOX_ENABLED=0
# TA_QLIB_SWEEPS_ENABLED=0
# TA_QLIB_BRIDGE_ENABLED=0
# TA_QLIB_DATA_DIR=data/qlib_sandbox
# TA_QLIB_BRIDGE_DIR=data/qlib_bridge
# TA_QLIB_GATE_MIN_HIT_RATE=55
# TA_QLIB_GATE_MIN_IC=0.02
# TA_QLIB_GATE_MIN_COVERAGE=30
# Qlib 本地数据验证（plan: qlib本地数据验证）
# TA_QLIB_DATA_URI=data/qlib_cn_data
# TA_QLIB_EXPORTS_CSV_DIR=data/qlib_exports/csv
# TA_QLIB_VALIDATION_LOG_DIR=logs/qlib_validation
# TA_QLIB_VALIDATION_START=2023-01-01
# TA_QLIB_VALIDATION_END=2026-05-25
# TA_QLIB_VALIDATION_RECENT_START=2026-01-01
# TA_QLIB_VALIDATION_TEST_START=2025-01-01
# TA_QLIB_UNIVERSE=csi300
# TA_QLIB_CSI300_INDEX=000300.SH
# TA_QLIB_EXPORTS_UNIVERSE_DIR=data/qlib_exports/universe
# 可选依赖：uv sync --group quant  （qlib / lightgbm / vectorbt）
# QLIB/ 独立工作区：git submodule add https://github.com/microsoft/qlib.git QLIB/qlib-official
